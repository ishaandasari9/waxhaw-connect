# Firebase web config for Waxhaw Connect.
# Copy to .env.local for development and add the same six values to the Vercel
# project as Environment Variables.
#
# These are browser keys. Firebase publishes them in client bundles by design,
# so they are not secrets. Access is controlled by firestore.rules, not by
# hiding these values.
#
# Find them in the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
