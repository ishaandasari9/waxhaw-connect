rules_version = '2';

// Waxhaw Connect access rules.
//
// Two collections, two very different audiences:
//   profiles/{uid}        private to the resident it belongs to
//   communityEvents/{id}  readable by anyone, writable only by its author,
//                         except that any other signed-in resident may append
//                         their own id to reportedBy to report the listing
//
// Residents browse the calendar without an account, so community events are
// public read on purpose. Nothing else is.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if owns(uid);
    }

    match /communityEvents/{eventId} {
      function validEvent(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 80
          && data.description is string && data.description.size() > 0 && data.description.size() <= 400
          && data.location is string && data.location.size() > 0 && data.location.size() <= 120
          && data.accessibility is string && data.accessibility.size() <= 260
          && data.date is string && data.date.size() == 10
          && data.time is string && data.time.size() <= 40
          && data.category is string && data.category.size() <= 40
          && data.organizer is string && data.organizer.size() <= 80
          && data.sourceUrl is string && data.sourceUrl.size() <= 300;
      }

      function reports(data) {
        return data.get('reportedBy', []);
      }

      // A report may only append the reporter's own id. Every other field must
      // be untouched, so this path cannot be used to edit or hide-by-rewrite
      // someone else's listing, and nobody can report the same event twice.
      function reportsOwnListing() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          && reports(request.resource.data) is list
          && reports(request.resource.data).size() == reports(resource.data).size() + 1
          && reports(request.resource.data).hasAll(reports(resource.data))
          && request.auth.uid in reports(request.resource.data)
          && !(request.auth.uid in reports(resource.data))
          && reports(request.resource.data).size() <= 50
          && resource.data.organizerId != request.auth.uid;
      }

      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid
        && reports(request.resource.data).size() == 0
        && validEvent(request.resource.data);
      // An author editing their own listing keeps whatever reports it has:
      // editing is not a way to clear them.
      allow update: if signedIn() && (
        (resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId == request.auth.uid
          && reports(request.resource.data) == reports(resource.data)
          && validEvent(request.resource.data))
        || reportsOwnListing()
      );
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
