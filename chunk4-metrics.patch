+.metrics__note { margin-top: 1rem; font-size: .8rem; color: var(--ink-soft); max-width: 62ch; }
+.metric-rows { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
+.metric-rows li { display: grid; gap: .4rem; padding: 1rem 1.2rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); }
+.metric-rows__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1rem; }
+.metric-rows__head strong { font-size: 1rem; }
+.metric-rows__value { font: 600 1.5rem/1 'Newsreader Variable', 'Newsreader', Georgia, serif; color: var(--forest-dark); }
+.metric-rows li p { margin: 0; font-size: .84rem; color: var(--ink-soft); max-width: 68ch; }
+.metric-rows__foot { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; font-size: .76rem; color: var(--ink-soft); }
+.verdict { display: inline-flex; align-items: center; gap: .3rem; padding: .15rem .55rem; border-radius: 999px; font-size: .74rem; font-weight: 700; }
+.verdict svg { width: .85rem; height: .85rem; }
+.verdict--met { background: var(--forest-light); color: var(--forest-dark); }
+.verdict--missed { background: var(--danger-light); color: var(--danger); }
+.verdict--neutral { background: var(--paper-deep); color: var(--ink-soft); }
+.vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
+.vital { display: grid; align-content: start; gap: .3rem; padding: 1.1rem 1.2rem; background: var(--surface); border: 1px solid var(--border); border-top: 4px solid var(--forest); border-radius: var(--radius-sm); }
+.vital--missed { border-top-color: var(--danger); }
+.vital__icon { display: inline-flex; color: var(--forest); }
+.vital__icon svg { width: 1.2rem; height: 1.2rem; }
+.vital strong { font: 600 1.9rem/1 'Newsreader Variable', 'Newsreader', Georgia, serif; color: var(--forest-dark); }
+.vital__label { font-size: .88rem; font-weight: 700; }
+.vital p { margin: .15rem 0 .4rem; font-size: .78rem; color: var(--ink-soft); }
+.vital__target { font-size: .74rem; color: var(--ink-soft); }
+.vital .verdict { justify-self: start; margin-top: .3rem; }
+@media (max-width: 640px) {
+  .metric-rows li { padding: .9rem 1rem; }
+  .metric-rows__value { font-size: 1.3rem; }
+}
